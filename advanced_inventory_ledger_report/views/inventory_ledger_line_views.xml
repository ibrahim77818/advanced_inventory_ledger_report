<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================ SEARCH ============================ -->
    <record id="view_inventory_ledger_line_search" model="ir.ui.view">
        <field name="name">inventory.ledger.line.search</field>
        <field name="model">inventory.ledger.line</field>
        <field name="arch" type="xml">
            <search string="Inventory Ledger">
                <field name="product_id"/>
                <field name="categ_id" filter_domain="[('categ_id', 'child_of', raw_value)]"/>
                <field name="warehouse_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="reference"/>
                <field name="partner_id"/>
                <filter name="with_movement" string="With Movements"
                        domain="['|', ('in_qty', '!=', 0), ('out_qty', '!=', 0)]"/>
                <filter name="inbound" string="Inbound" domain="[('in_qty', '&gt;', 0)]"/>
                <filter name="outbound" string="Outbound" domain="[('out_qty', '&gt;', 0)]"/>
                <separator/>
                <filter name="negative_closing" string="Negative Closing"
                        domain="[('line_type', '=', 'summary'), ('closing_qty', '&lt;', 0)]"/>
                <filter name="negative_balance" string="Negative Running Balance"
                        domain="[('line_type', '=', 'move'), ('balance_qty', '&lt;', 0)]"/>
                <group>
                    <filter name="groupby_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter name="groupby_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="groupby_category" string="Product Category" context="{'group_by': 'categ_id'}"/>
                    <filter name="groupby_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="groupby_movement_type" string="Movement Type" context="{'group_by': 'movement_type'}"/>
                    <filter name="groupby_date" string="Date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================ SUMMARY ============================ -->
    <record id="view_inventory_ledger_line_summary_tree" model="ir.ui.view">
        <field name="name">inventory.ledger.line.summary.tree</field>
        <field name="model">inventory.ledger.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Inventory Ledger - Summary" create="0" edit="0" delete="0"
                  decoration-danger="closing_qty &lt; 0" decoration-muted="in_qty == 0 and out_qty == 0">
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="warehouse_id"/>
                <field name="default_code" optional="hide"/>
                <field name="product_id"/>
                <field name="categ_id" optional="hide"/>
                <field name="uom_id" optional="show" groups="uom.group_uom"/>
                <field name="opening_qty" sum="Opening"/>
                <field name="in_purchase_qty" sum="Purchases" optional="show"/>
                <field name="in_return_qty" sum="Customer Returns" optional="hide"/>
                <field name="in_internal_qty" sum="Internal IN" optional="show"/>
                <field name="in_other_qty" sum="Other IN" optional="hide"/>
                <field name="in_qty" sum="Total IN" class="fw-bold"/>
                <field name="out_sale_qty" sum="Sales" optional="show"/>
                <field name="out_return_qty" sum="Vendor Returns" optional="hide"/>
                <field name="out_internal_qty" sum="Internal OUT" optional="show"/>
                <field name="out_other_qty" sum="Other OUT" optional="hide"/>
                <field name="out_qty" sum="Total OUT" class="fw-bold"/>
                <field name="closing_qty" sum="Closing" class="fw-bold"/>
                <field name="unit_cost" optional="hide"/>
                <field name="opening_value" sum="Opening Value" optional="hide"/>
                <field name="in_value" sum="IN Value" optional="hide"/>
                <field name="out_value" sum="OUT Value" optional="hide"/>
                <field name="closing_value" sum="Closing Value" optional="show"/>
                <field name="line_type" column_invisible="1"/>
                <button name="action_open_moves" type="object" icon="fa-search-plus"
                        title="Show stock moves" string="Moves"/>
            </list>
        </field>
    </record>

    <record id="view_inventory_ledger_line_summary_pivot" model="ir.ui.view">
        <field name="name">inventory.ledger.line.summary.pivot</field>
        <field name="model">inventory.ledger.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <pivot string="Inventory Ledger - Summary" sample="0">
                <field name="categ_id" type="row"/>
                <field name="warehouse_id" type="col"/>
                <field name="opening_qty" type="measure"/>
                <field name="in_qty" type="measure"/>
                <field name="out_qty" type="measure"/>
                <field name="closing_qty" type="measure"/>
                <field name="balance_qty" invisible="1"/>
                <field name="unit_cost" invisible="1"/>
            </pivot>
        </field>
    </record>

    <record id="view_inventory_ledger_line_summary_graph" model="ir.ui.view">
        <field name="name">inventory.ledger.line.summary.graph</field>
        <field name="model">inventory.ledger.line</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <graph string="Inventory Ledger - Summary" type="bar" stacked="1" sample="0">
                <field name="warehouse_id"/>
                <field name="categ_id"/>
                <field name="closing_qty" type="measure"/>
                <field name="balance_qty" invisible="1"/>
            </graph>
        </field>
    </record>

    <!-- ============================ DETAILED ============================ -->
    <record id="view_inventory_ledger_line_detailed_tree" model="ir.ui.view">
        <field name="name">inventory.ledger.line.detailed.tree</field>
        <field name="model">inventory.ledger.line</field>
        <field name="priority">21</field>
        <field name="arch" type="xml">
            <list string="Inventory Ledger - Detailed" create="0" edit="0" delete="0"
                  decoration-info="line_type == 'opening'" decoration-bf="line_type == 'opening'"
                  decoration-danger="balance_qty &lt; 0">
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="warehouse_id"/>
                <field name="product_id"/>
                <field name="date"/>
                <field name="line_type" column_invisible="1"/>
                <field name="movement_type"/>
                <field name="reference" optional="show"/>
                <field name="picking_id" optional="hide"/>
                <field name="partner_id" optional="show"/>
                <field name="uom_id" optional="hide" groups="uom.group_uom"/>
                <field name="opening_qty" optional="hide"/>
                <field name="in_qty" sum="Total IN"/>
                <field name="out_qty" sum="Total OUT"/>
                <field name="balance_qty" class="fw-bold"/>
                <field name="unit_cost" optional="show"/>
                <field name="in_value" sum="IN Value" optional="show"/>
                <field name="out_value" sum="OUT Value" optional="show"/>
                <button name="action_open_moves" type="object" icon="fa-external-link"
                        title="Open source document" string="Open"/>
            </list>
        </field>
    </record>

    <record id="view_inventory_ledger_line_detailed_pivot" model="ir.ui.view">
        <field name="name">inventory.ledger.line.detailed.pivot</field>
        <field name="model">inventory.ledger.line</field>
        <field name="priority">21</field>
        <field name="arch" type="xml">
            <pivot string="Inventory Ledger - Detailed" sample="0">
                <field name="product_id" type="row"/>
                <field name="movement_type" type="col"/>
                <field name="in_qty" type="measure"/>
                <field name="out_qty" type="measure"/>
                <field name="balance_qty" invisible="1"/>
                <field name="unit_cost" invisible="1"/>
            </pivot>
        </field>
    </record>

    <record id="view_inventory_ledger_line_detailed_graph" model="ir.ui.view">
        <field name="name">inventory.ledger.line.detailed.graph</field>
        <field name="model">inventory.ledger.line</field>
        <field name="priority">21</field>
        <field name="arch" type="xml">
            <graph string="Inventory Ledger - Detailed" type="line" sample="0">
                <field name="date" interval="day"/>
                <field name="in_qty" type="measure"/>
                <field name="out_qty" type="measure"/>
                <field name="balance_qty" invisible="1"/>
            </graph>
        </field>
    </record>
</odoo>

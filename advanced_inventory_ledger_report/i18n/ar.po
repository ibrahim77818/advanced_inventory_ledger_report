#. module: advanced_inventory_ledger_report
#: model_terms:ir.ui.view,arch_db:advanced_inventory_ledger_report.view_inventory_ledger_wizard_form
msgid ""
"<i class=\"fa fa-info-circle me-1\" title=\"Info\"/>\n"
"                    Transfers between two selected warehouses appear as <b>Internal OUT</b> in the\n"
"                    source and <b>Internal IN</b> in the destination. Moves inside one warehouse\n"
"                    (put-away, picking) do not affect its totals."
msgstr ""
"<i class=\"fa fa-info-circle me-1\" title=\"معلومة\"/>\n"
"                    تظهر التحويلات بين مستودعين محددين كـ <b>صادر داخلي</b> في المستودع\n"
"                    المصدر و<b>وارد داخلي</b> في المستودع الوجهة. أما الحركات داخل المستودع نفسه\n"
"                    (التخزين، الانتقاء) فلا تؤثر على إجمالياته."


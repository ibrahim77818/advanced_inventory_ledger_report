<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Each user only sees the ledger runs they generated -->
        <record id="rule_inventory_ledger_wizard_own" model="ir.rule">
            <field name="name">Inventory Ledger Wizard: own runs only</field>
            <field name="model_id" ref="model_inventory_ledger_wizard"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

        <record id="rule_inventory_ledger_line_own" model="ir.rule">
            <field name="name">Inventory Ledger Line: own runs only</field>
            <field name="model_id" ref="model_inventory_ledger_line"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

        <!-- Lines are written with raw SQL, so enforce company isolation on read -->
        <record id="rule_inventory_ledger_line_company" model="ir.rule">
            <field name="name">Inventory Ledger Line: multi-company</field>
            <field name="model_id" ref="model_inventory_ledger_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_ledger_wizard_form" model="ir.ui.view">
        <field name="name">inventory.ledger.wizard.form</field>
        <field name="model">inventory.ledger.wizard</field>
        <field name="arch" type="xml">
            <form string="Inventory Ledger">
                <group>
                    <group string="Report">
                        <field name="report_type" widget="radio" options="{'horizontal': true}"/>
                        <label for="date_from" string="Period"/>
                        <div class="o_row">
                            <field name="date_from" class="oe_inline"/>
                            <i class="fa fa-long-arrow-right mx-2" title="to"/>
                            <field name="date_to" class="oe_inline"/>
                        </div>
                        <field name="opening_method" widget="radio"/>
                        <field name="hide_zero"/>
                    </group>
                    <group string="Scope">
                        <field name="company_ids" invisible="1"/>
                        <field name="company_ids" widget="many2many_tags"
                               groups="base.group_multi_company" options="{'no_create': True}"/>
                        <field name="warehouse_ids" widget="many2many_tags"
                               options="{'no_create': True}" placeholder="All warehouses"/>
                        <field name="categ_ids" widget="many2many_tags"
                               options="{'no_create': True}" placeholder="All categories"/>
                        <field name="product_ids" widget="many2many_tags"
                               options="{'no_create': True}" placeholder="All products tracked in inventory"/>
                    </group>
                </group>
                <div class="alert alert-info mb-0" role="status">
                    <i class="fa fa-info-circle me-1" title="Info"/>
                    Transfers between two selected warehouses appear as <b>Internal OUT</b> in the
                    source and <b>Internal IN</b> in the destination. Moves inside one warehouse
                    (put-away, picking) do not affect its totals.
                </div>
                <footer>
                    <button name="action_view_report" string="View" type="object"
                            class="btn-primary" icon="fa-table" data-hotkey="q"/>
                    <button name="action_export_xlsx" string="Excel" type="object"
                            class="btn-secondary" icon="fa-file-excel-o" data-hotkey="x"/>
                    <button name="action_print_pdf" string="PDF" type="object"
                            class="btn-secondary" icon="fa-file-pdf-o" data-hotkey="p"/>
                    <button string="Cancel" special="cancel" class="btn-link" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_inventory_ledger_wizard" model="ir.actions.act_window">
        <field name="name">Inventory Ledger</field>
        <field name="res_model">inventory.ledger.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_inventory_ledger_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
